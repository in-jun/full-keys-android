<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-to-device transfer on Android 12 and above. Same as
    backup_rules.xml: the settings travel, and there is nothing else.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
